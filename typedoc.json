{
  "$schema": "https://typedoc.org/schema.json",
  "name": "postgrelize",
  "entryPoints": ["src/index.ts"],
  "tsconfig": "tsconfig.build.json",
  "out": "docs-site",
  "readme": "README.md",
  "includeVersion": true,
  "excludePrivate": true,
  "excludeInternal": true,
  "githubPages": true,
  "gitRevision": "main",
  "sourceLinkExternal": true,
  "validation": {
    "notExported": false,
    "invalidLink": true,
    "notDocumented": true
  },
  "treatWarningsAsErrors": true
}
