{
  "name": "@tormozz48/postgrelize",
  "version": "0.6.0",
  "description": "PostgreSQL-only ORM, drop-in compatible with the Sequelize v6 API",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tormozz48/postgrelize.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "vite build",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --project integration --project compat",
    "test:unit": "vitest run --project unit",
    "test:build": "vitest run --project build",
    "test:integration": "vitest run --project integration",
    "test:compat": "vitest run --project compat",
    "test:db": "vitest run --project integration --project compat",
    "test:coverage": "vitest run --project unit --project integration --project compat --coverage && node scripts/coverage-badge.mjs",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down -v",
    "prepublishOnly": "npm run build",
    "docs": "typedoc"
  },
  "dependencies": {
    "inflection": "~1.13.4",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@types/inflection": "^1.13.2",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/validator": "^13.15.10",
    "@vitest/coverage-v8": "^5.1.0",
    "oxfmt": "0.78.0",
    "oxlint": "^1.93.0",
    "pg": "^8.23.1",
    "sequelize": "~6.37.8",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typedoc-vitepress-theme": "^1.1.4",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2",
    "vitepress": "^1.6.4",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "pg": "^8.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
