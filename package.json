{
  "name": "postgrelize",
  "version": "1.2.0",
  "description": "PostgreSQL-only ORM, drop-in compatible with the Sequelize v6 API. Ships llm/USAGE.md and an Agent Skill for LLMs.",
  "keywords": [
    "jsonb",
    "migrations",
    "orm",
    "pg",
    "postgres",
    "postgresql",
    "query-builder",
    "sequelize",
    "sequelize-v6",
    "typescript",
    "upsert"
  ],
  "homepage": "https://tormozz48.github.io/postgrelize/",
  "bugs": {
    "url": "https://github.com/tormozz48/postgrelize/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tormozz48/postgrelize.git"
  },
  "files": [
    "dist",
    "llm",
    "skills",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vite build",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --project decorators-legacy --project integration --project compat --project docs",
    "test:unit": "vitest run --project unit --project decorators-legacy",
    "test:build": "vitest run --project build",
    "test:integration": "vitest run --project integration",
    "test:compat": "vitest run --project compat",
    "test:db": "vitest run --project integration --project compat --project docs",
    "test:coverage": "vitest run --project unit --project integration --project compat --project docs --coverage && node scripts/coverage-badge.mjs",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down -v",
    "v6:db": "sh scripts/v6-suite/db.sh up",
    "v6:db:down": "sh scripts/v6-suite/db.sh down",
    "v6:suite": "node --experimental-strip-types scripts/v6-suite/run.ts",
    "prepublishOnly": "npm run llm:build && npm run build",
    "api:differences": "node --experimental-strip-types scripts/generate-api-differences.ts",
    "llm:build": "node --experimental-strip-types scripts/generate-llm.ts",
    "release:preflight": "node --experimental-strip-types scripts/release-preflight.ts",
    "docs:options": "node --experimental-strip-types scripts/generate-option-reference.ts",
    "docs": "typedoc && npm run docs:options && vitepress build docs",
    "docs:dev": "typedoc && npm run docs:options && vitepress dev docs",
    "docs:examples": "vitest run --project docs",
    "bench": "vitest run --project bench"
  },
  "dependencies": {
    "inflection": "~1.13.4",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@types/inflection": "^1.13.2",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/validator": "^13.15.10",
    "@vitest/coverage-v8": "^5.1.0",
    "expect-type-v6": "npm:expect-type@0.12.0",
    "fast-check": "^4.10.2",
    "oxfmt": "0.78.0",
    "oxlint": "^1.93.0",
    "pg": "^8.23.1",
    "sequelize": "~6.37.8",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typedoc-vitepress-theme": "^1.1.4",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2",
    "vitepress": "^1.6.4",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "pg": "^8.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
