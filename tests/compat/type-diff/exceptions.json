{
  "skipTypes": ["Validator"],
  "causes": {
    "hooks": {
      "category": "tracked",
      "note": "Hook methods missing: static Sequelize.addHook/before*/after*/hasHook(s)/removeHook, Sequelize and Model instance-level hook members. Runtime allow-list says not-planned; TypeScript users still hit them."
    },
    "sequelize-members": {
      "category": "tracked",
      "note": "Other Sequelize members missing: set, modelManager, Sequelize.Sequelize self reference."
    },
    "query-interface-members": {
      "category": "tracked",
      "note": "QueryInterface members missing (select, insert, update, upsert, delete, increment, rawSelect, quoteTable, nameIndexes, queryGenerator, transaction helpers). Some are not-planned at runtime."
    },
    "query-interface-arity": {
      "category": "tracked",
      "note": "QueryInterface method accepts fewer arguments, or requires more, than v6 (attributes argument of bulkInsert, options of addIndex / bulkDelete, optional options of createSchema / dropSchema)."
    },
    "model-arity": {
      "category": "tracked",
      "note": "Model.setAttributes accepts fewer arguments than v6."
    },
    "option-keys": {
      "category": "tracked",
      "note": "Key declared by a v6 options interface and missing here (bind, mapToModel, groupedLimit, omitNull, raw, reset, isNewRecord, where, hooks, validate, paranoid, ...)."
    },
    "query-options-internal": {
      "category": "internal",
      "note": "Keys v6 declares on query options but documents as internal (fieldMap, instance)."
    },
    "other-dialect": {
      "category": "other-dialect",
      "note": "Options used only by other dialects (indexHints, ignoreDuplicates, storage, ...)."
    },
    "search-path": {
      "category": "not-planned",
      "note": "searchPath is set per connection / query in postgrelize, not through every options type."
    },
    "association-members": {
      "category": "tracked",
      "note": "Association members missing: identifier, inspect, isSelfAssociation."
    },
    "datatype-members": {
      "category": "tracked",
      "note": "IntegerDataType runtime members (options, stringify, validate, toSql, dialectTypes) are not in the type."
    },
    "error-members": {
      "category": "tracked",
      "note": "Error class members missing: AggregateError.toString, ForeignKeyConstraintError.value / reltype, ValidationErrorItem helpers and statics."
    },
    "generic-params": {
      "category": "tracked",
      "note": "Type parameters differ in count or in which have defaults, so v6 explicit type arguments (Options<T, TAttributes>) fail to compile."
    },
    "class-as-type": {
      "category": "tracked",
      "note": "Exported as a type only, so the value cannot be used (instanceof BelongsTo, new HasMany)."
    },
    "enum-as-type": {
      "category": "tracked",
      "note": "Enum exported as a type only; the value is missing in the declarations."
    },
    "namespace-as-value": {
      "category": "tracked",
      "note": "Namespace exported as a value only; types under it (DataTypes.StringDataType, Utils.*) are missing."
    }
  },
