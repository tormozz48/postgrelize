{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-imports": "error",
    "no-var": "error",
    "prefer-const": "error",
    "eqeqeq": "error",
    "no-param-reassign": "error",
    "import/no-cycle": "error",
    "import/no-default-export": "error",
    "typescript/explicit-module-boundary-types": "error",
    "no-underscore-dangle": [
      "error",
      {
        "allow": [
          "_previousDataValues",
          "_attributes",
          "_creationAttributes",
          "_model",
          "_autoGenerated"
        ],
        "allowAfterThis": true
      }
    ],
    "vitest/expect-expect": [
      "error",
      {
        "assertFunctionNames": [
          "expect",
          "expectSameResult",
          "expectSameError",
          "withUsers",
          "withProducts",
          "run"
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["*.config.ts"],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      "files": ["docs/.vitepress/config.ts"],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      "files": ["tests/**", "*.config.ts"],
      "rules": {
        "typescript/explicit-module-boundary-types": "off"
      }
    },
    {
      "files": ["src/**"],
      "rules": {
        "max-lines": [
          "error",
          {
            "max": 150,
            "skipBlankLines": true,
            "skipComments": true
          }
        ],
        "max-lines-per-function": [
          "error",
          {
            "max": 20,
            "skipBlankLines": true,
            "skipComments": true
          }
        ]
      }
    },
    {
      "files": [
        "src/associations/association-keys.ts",
        "src/associations/association.ts",
        "src/associations/belongs-to-many.ts",
        "src/associations/include-loader.ts",
        "src/associations/include-query-builder.ts",
        "src/connection/connection-manager.ts",
        "src/connection/copy.ts",
        "src/ddl/ddl-generator.ts",
        "src/errors/errors.ts",
        "src/expressions/methods.ts",
        "src/index.ts",
        "src/query-interface/query-interface.ts",
        "src/query-interface/schema-synchronizer.ts",
        "src/sequelize.ts",
        "src/sql/ast.ts",
        "src/sql/compile.ts",
        "src/transaction/transaction.ts",
        "src/validation/instance-validator.ts",
        "src/where/where.ts"
      ],
      "rules": {
        "max-lines": "off"
      }
    },
    {
      "files": [
        "src/associations/association-keys.ts",
        "src/associations/association.ts",
        "src/associations/belongs-to-many.ts",
        "src/associations/belongs-to.ts",
        "src/associations/has-one.ts",
        "src/associations/include-loader.ts",
        "src/associations/include-query-builder.ts",
        "src/associations/include-resolver.ts",
        "src/associations/nested-creator.ts",
        "src/connection/connection-config.ts",
        "src/connection/connection-manager.ts",
        "src/connection/copy.ts",
        "src/data-types/array-literal-parser.ts",
        "src/ddl/ddl-generator.ts",
        "src/ddl/sql-literal.ts",
        "src/errors/errors.ts",
        "src/errors/map-pg-error.ts",
        "src/query-interface/query-interface.ts",
        "src/query-interface/schema-synchronizer.ts",
        "src/query/raw-query.ts",
        "src/sequelize.ts",
        "src/sql/compile.ts",
        "src/transaction/transaction.ts",
        "src/validation/instance-validator.ts",
        "src/where/where.ts"
      ],
      "rules": {
        "max-lines-per-function": "off"
      }
    }
  ],
  "env": {
    "builtin": true,
    "node": true
  },
  "ignorePatterns": ["dist", "coverage", "node_modules", "docs/api", "docs/.vitepress/cache"]
}
